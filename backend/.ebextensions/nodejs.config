option_settings:
  aws:elasticbeanstalk:container:nodejs:
    NodeVersion: 22.x
  aws:autoscaling:launchconfiguration:
    EnvironmentVariables: NODE_ENV=production,NODE_OPTIONS=-Xmx256m
  
commands:
  01_install_node_22:
    command: |
      amazon-linux-extras install nodejs22 -y || true
      node --version
    ignoreErrors: true
  02_npm_cache_clean:
    command: npm cache clean --force
    cwd: /var/app/current
  03_prisma_generate:
    command: npx prisma generate
    cwd: /var/app/current
    leader_only: true
