generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  REQUESTER
  PARISH_SECRETARY
  PARISH_PRIEST
  ADMIN
}

enum RequestStatus {
  PENDING
  SECRETARY_REVIEW
  PRIEST_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum ApprovalActionType {
  APPROVED
  REJECTED
  REVISION_REQUESTED
  FORWARDED
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String
  role       UserRole
  ministryId String?
  ministry   Ministry? @relation(fields: [ministryId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  requests        VenueRequest[]   @relation("RequesterRequests")
  approvals       VenueRequest[]   @relation("CurrentApproverRequests")
  approvalActions ApprovalAction[]
  auditLogs       AuditLog[]
}

model Ministry {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venues   VenueMinistry[]
  users    User[]
  requests VenueRequest[]
}

model Venue {
  id          String   @id @default(cuid())
  name        String
  description String?
  capacity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requests             VenueRequest[]
  authorizedMinistries VenueMinistry[]
}

model VenueRequest {
  id                  String        @id @default(cuid())
  requesterId         String
  venueId             String
  ministryId          String
  eventName           String
  purpose             String
  startDateTime       DateTime
  endDateTime         DateTime
  attendees           Int
  specialRequirements String?
  status              RequestStatus @default(PENDING)
  currentApproverId   String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  requester       User                 @relation("RequesterRequests", fields: [requesterId], references: [id])
  venue           Venue                @relation(fields: [venueId], references: [id])
  ministry        Ministry             @relation(fields: [ministryId], references: [id])
  currentApprover User?                @relation("CurrentApproverRequests", fields: [currentApproverId], references: [id])
  approvalActions ApprovalAction[]
  conflicts       SchedulingConflict[]

  @@index([status])
  @@index([requesterId])
}

model ApprovalAction {
  id         String             @id @default(cuid())
  requestId  String
  approverId String
  action     ApprovalActionType
  remarks    String?
  createdAt  DateTime           @default(now())

  request  VenueRequest @relation(fields: [requestId], references: [id])
  approver User         @relation(fields: [approverId], references: [id])
}

model AuditLog {
  id            String   @id @default(cuid())
  requestId     String?
  performedById String
  action        String
  details       Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  performedBy User @relation(fields: [performedById], references: [id])
}

model SchedulingConflict {
  id                   String   @id @default(cuid())
  requestId            String
  conflictingRequestId String
  detectedAt           DateTime @default(now())

  request VenueRequest @relation(fields: [requestId], references: [id])
}

model VenueMinistry {
  id         String   @id @default(cuid())
  venueId    String
  ministryId String
  createdAt  DateTime @default(now())

  venue    Venue    @relation(fields: [venueId], references: [id])
  ministry Ministry @relation(fields: [ministryId], references: [id])

  @@unique([venueId, ministryId])
}
